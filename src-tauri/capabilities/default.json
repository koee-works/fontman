{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, the folder picker, showing library folders in the file manager, and opening Google's API-key pages and font specimen pages in the browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://console.cloud.google.com/*" },
        { "url": "https://developers.google.com/fonts/*" },
        { "url": "https://fonts.google.com/specimen/*" }
      ]
    }
  ]
}
