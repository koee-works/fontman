{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Font Manager",
  "version": "0.3.0",
  "identifier": "dev.fontmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Font Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' font: http://font.localhost",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNzhFQUNGNDY3MTk0RDQKUldUVWxIRkd6K3A0WWFuQWZuQ2MyVFZtWVI0anI1VUduVzRxajdsZmVrK1d0NDRUNzBPTEN4SjAK",
      "endpoints": [
        "https://github.com/koee-works/fontman/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
